{
  "name": "@xrnavigation/audiom-embedder",
  "version": "1.0.0",
  "description": "A strongly-typed TypeScript client library for embedding Audiom inclusive mapping solutions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "changelog:add": "changelog-note",
    "changelog:note:check": "check-changelog-note --staged",
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=test-results.json",
    "prepublishOnly": "npm run build",
    "clean": "rmdir /s /q dist 2>nul || exit 0"
  },
  "keywords": [
    "audiom",
    "maps",
    "accessibility",
    "embed",
    "typescript"
  ],
  "author": "XR Navigation Inc.",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "changelog-tools": "git+https://github.com/xrnavigation/changelog-tools.git",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "repository": {
    "type": "git",
    "url": ""
  }
}
